# Variabili d'ambiente per il backend Farmaco Chiaro
# Copia questo file in .env e compila i valori

OPENROUTER_API_KEY=la_tua_api_key_qui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelli OpenRouter
CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
SIMPLIFY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Timeout LLM in secondi
LLM_TIMEOUT=90

# Retrieval: semantic = Qdrant come fonte primaria (BM25 solo come fallback);
# bm25 = solo lessicale (test e uso offline). La home usa sempre keyword + semantica.
RETRIEVAL_MODE=semantic

# Embeddings (OpenRouter)
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_TIMEOUT=60
EMBEDDING_BATCH_SIZE=32

# Qdrant (Cloud o server locale). Per Docker Compose usare http://qdrant:6333.
QDRANT_URL=https://xxxx-xxxx.eu-central-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=farmaci_v1
QDRANT_TIMEOUT=4

# Sintesi vocale (OpenRouter TTS / HeyGen Voice Turbo)
TTS_MODEL=heygen/heygen-voice-1-turbo:free
TTS_VOICE=nadine
TTS_TIMEOUT=90
TTS_MAX_CHARS=5000
TTS_SAMPLE_RATE=16000

# Origini CORS esplicite separate da virgola.
# Con il proxy Next.js same-origin, il browser non chiama direttamente il backend.
FRONTEND_ORIGINS=http://localhost:3000
